<!doctype html>
{%- comment -%}
  p*q · Diseño de página para las salas: la sala ocupa toda la pantalla, sin el encabezado ni el pie
  del tema. Arriba queda solo una barra fina con la marca, el nombre de la sala y el carrito.
  Lo usa templates/metaobject/sala.json ("layout": "pq-sala").
{%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }} · {{ shop.name }}</title>
    {%- if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}
    <style>
      html, body { margin: 0; }
      body { font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; background: #1d1a17; color: #1d1a17; }
      .pq-barra {
        position: fixed; inset: 0 0 auto 0; z-index: 10;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 0.75rem clamp(1rem, 3vw, 2rem);
        background: linear-gradient(rgba(20, 18, 16, 0.55), rgba(20, 18, 16, 0));
        color: #fbf8f3; pointer-events: none;
      }
      .pq-barra a { color: inherit; text-decoration: none; pointer-events: auto; }
      .pq-barra__marca { font-weight: 700; font-size: 1.25rem; letter-spacing: 0.02em; }
      .pq-barra__sala { flex: 1; opacity: 0.85; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pq-barra__carrito { padding: 0.35rem 0.8rem; border: 1px solid currentColor; border-radius: 999px; }
      main { background: #fbf8f3; }
    </style>
  </head>
  <body>
    <header class="pq-barra">
      <a class="pq-barra__marca" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
      <span class="pq-barra__sala">{{ page_title | escape }}</span>
      <a class="pq-barra__carrito" href="{{ routes.cart_url }}">
        Carrito (<span data-pq-contador>{{ cart.item_count }}</span>)
      </a>
    </header>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
