{
  "name": "pq-salas",
  "version": "0.1.0",
  "private": true,
  "description": "Salas por capas de p*q para Shopify",
  "type": "module",
  "scripts": {
    "preparar:ejemplo": "node scripts/preparar-sala.mjs capas-ejemplo prototipo/sala",
    "sala2:provisoria": "node scripts/generar-sala-2-provisoria.mjs && node scripts/preparar-sala.mjs capas-ejemplo prototipo/sala && node scripts/preparar-sala.mjs capas-sala-2 prototipo/sala-2",
    "preparar:sala2": "node scripts/preparar-sala.mjs capas-sala-2 prototipo/sala-2",
    "probar:seccion": "node scripts/probar-seccion.mjs",
    "servidor": "node scripts/servidor.mjs",
    "probar:prototipo": "node scripts/probar-prototipo.mjs",
    "probar:puertas": "node scripts/probar-puertas.mjs",
    "instalar": "node scripts/instalar-en-tema.mjs"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "liquidjs": "^10.29.0",
    "playwright": "^1.63.0"
  }
}
